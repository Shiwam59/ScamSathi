# ScamSathi Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env or .env.local to version control.

# Required: Google Gemini API Key (server-side only)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Google Safe Browsing API Key for live threat lookup (server-side only)
GOOGLE_SAFE_BROWSING_API_KEY=your_safe_browsing_api_key_here

# Optional: ElevenLabs Voice Guidance (server-side only)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id_here

# Optional: MongoDB Atlas (for anonymized report history)
MONGODB_URI=your_mongodb_connection_string_here

# Optional: Snowflake (Stretch goal)
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_DATABASE=
# SNOWFLAKE_SCHEMA=
